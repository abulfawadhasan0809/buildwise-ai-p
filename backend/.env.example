# Gnani AI (keep server-side only). URLs default to the official endpoints, so you can leave them out.
GNANI_API_KEY=your_api_key
GNANI_LANG=en-IN
GNANI_VOICE=Kaveri
GNANI_TTS_MODEL=timbre-v2.5
# Usage limits to protect your credits (reset when the server restarts)
GNANI_CALLS_PER_IP=6
GNANI_CALLS_TOTAL=150
# Optional: enables LLM-written explanations
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
ALLOWED_ORIGIN=http://localhost:3000
